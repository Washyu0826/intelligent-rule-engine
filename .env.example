# ============================================================
# Rules MCP Server — Environment Variables
# ============================================================
# Copy to .env and fill in your values
# ============================================================

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# LLM Provider (gemini | ollama | claude)
RULES_LLM_PROVIDER=gemini
RULES_LLM_MODEL=gemini-2.0-flash
RULES_LLM_TIMEOUT_SECONDS=30

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here

# Ollama (if using local)
RULES_LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434
