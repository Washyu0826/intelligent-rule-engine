{
  "ruleType": "DecisionTable",
  "reason": "三項健康獎勵條件獨立判斷可累加，使用 MULTI hitPolicy",
  "rule": {
    "hitPolicy": "MULTI",
    "inputs": [
      { "name": "exercise_met", "typeRef": "BOOLEAN" },
      { "name": "sleep_met", "typeRef": "BOOLEAN" },
      { "name": "bmi_normal", "typeRef": "BOOLEAN" }
    ],
    "outputs": [
      { "name": "discount", "typeRef": "DECIMAL" },
      { "name": "remark", "typeRef": "STRING" }
    ],
    "rules": [
      {
        "ruleId": "R01",
        "priority": 1,
        "conditions": [
          { "field": "exercise_met", "operator": "equals", "value": true },
          { "field": "sleep_met", "operator": "anything" },
          { "field": "bmi_normal", "operator": "anything" }
        ],
        "results": [
          { "field": "discount", "value": 0.01 },
          { "field": "remark", "value": "運動達標折減" }
        ]
      },
      {
        "ruleId": "R02",
        "priority": 2,
        "conditions": [
          { "field": "exercise_met", "operator": "anything" },
          { "field": "sleep_met", "operator": "equals", "value": true },
          { "field": "bmi_normal", "operator": "anything" }
        ],
        "results": [
          { "field": "discount", "value": 0.005 },
          { "field": "remark", "value": "睡眠充足折減" }
        ]
      },
      {
        "ruleId": "R03",
        "priority": 3,
        "conditions": [
          { "field": "exercise_met", "operator": "anything" },
          { "field": "sleep_met", "operator": "anything" },
          { "field": "bmi_normal", "operator": "equals", "value": true }
        ],
        "results": [
          { "field": "discount", "value": 0.003 },
          { "field": "remark", "value": "BMI正常折減" }
        ]
      }
    ]
  }
}
