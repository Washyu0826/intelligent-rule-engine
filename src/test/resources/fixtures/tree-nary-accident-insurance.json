        },
        {
          "label": "FALSE",
          "condition": { "field": "age_eligible", "operator": "notEquals", "value": true },
          "child": {
            "nodeId": "N17",
            "results": [
              { "field": "decision", "value": "rejected" },
              { "field": "max_coverage", "value": "not_insurable" },
              { "field": "exclusion_clause", "value": "" },
