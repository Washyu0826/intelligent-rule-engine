{
  "ruleType": "DecisionTree",
  "reason": "意外險核保決策樹：根據年齡是否合格、職業類別（6類 N-ary）、高風險活動、理賠次數、殘廢等級進行分層判斷。職業類別使用 6-way 分支，殘廢等級使用 3-way 分支。",
  "schemaVersion": "1.0.0",
  "promptVersion": "p2.1.0",
  "evaluation": {
    "completeness": "COMPLETE",
    "totalScenarios": 14,
    "coverageRate": 1.0,
    "conflictDetection": "NO_CONFLICT",
    "recommendedStrategy": "FIRST"
  },
  "rule": {
    "inputs": [
      { "name": "age_eligible", "typeRef": "BOOLEAN" },
      { "name": "occupation_class", "typeRef": "ENUM", "allowedValues": ["class_1", "class_2", "class_3", "class_4", "class_5", "class_6"] },
      { "name": "high_risk_activity", "typeRef": "BOOLEAN" },
      { "name": "claim_count_3yr", "typeRef": "ENUM", "allowedValues": ["0", "1", "2+"] },
      { "name": "disability_grade", "typeRef": "ENUM", "allowedValues": ["none", "grade_1_6", "grade_7_11"] }
    ],
    "outputs": [
      { "name": "decision", "typeRef": "ENUM", "allowedValues": ["approved", "exclusion", "surcharge_approved", "rejected"] },
      { "name": "max_coverage", "typeRef": "ENUM", "allowedValues": ["5000000", "10000000", "20000000", "not_insurable"] },
      { "name": "exclusion_clause", "typeRef": "STRING" },
      { "name": "remark", "typeRef": "STRING" }
    ],
    "root": {
      "nodeId": "N01",
      "condition": { "field": "age_eligible", "operator": "equals", "value": true },
      "branches": [
        {
          "label": "TRUE",
          "condition": { "field": "age_eligible", "operator": "equals", "value": true },
          "child": {
            "nodeId": "N02",
