              {
                "label": "class_5",
                "condition": { "field": "occupation_class", "operator": "equals", "value": "class_5" },
                "child": {
                  "nodeId": "N15",
                  "results": [
                    { "field": "decision", "value": "surcharge_approved" },
                    { "field": "max_coverage", "value": "5000000" },
                    { "field": "exclusion_clause", "value": "" },
                    { "field": "remark", "value": "第5類職業，加費核准、額度上限500萬" }
