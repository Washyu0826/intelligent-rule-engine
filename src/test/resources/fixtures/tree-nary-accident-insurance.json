                          { "field": "max_coverage", "value": "20000000" },
                          { "field": "exclusion_clause", "value": "" },
                          { "field": "remark", "value": "第1類職業、1次理賠，核准最高2000萬" }
                        ]
                      }
                    },
                    {
                      "label": "2+",
                      "condition": { "field": "claim_count_3yr", "operator": "equals", "value": "2+" },
                      "child": {
                        "nodeId": "N06",
                        "results": [
                          { "field": "decision", "value": "surcharge_approved" },
