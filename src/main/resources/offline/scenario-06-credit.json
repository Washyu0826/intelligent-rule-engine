{
  "ruleType": "DecisionTable",
  "reason": "此規則集為信用風險評估決策表，包含 3 個條件欄位（credit_score 信用評分、annual_income 年收入、employment_years 工作年資）與 3 個結果欄位（risk_level 風險等級、credit_limit 授信額度、review_required 是否需人工審查）。條件組合共 3×3×2 = 18 種場景，採用 FIRST 策略，因為每位申請人只應歸類到一個風險等級。高信用分+高收入+穩定工作者可獲最高額度，反之降低額度或拒絕。",
  "evaluation": {
    "completeness": "COMPLETE",
    "totalScenarios": 18,
    "coverageRate": 1.0,
    "conflictDetection": "NO_CONFLICT",
    "recommendedStrategy": "FIRST"
  },
  "schemaVersion": "1.0.0",
  "promptVersion": "p2.0.0",
