          { "field": "hypertension", "operator": "equals", "value": true },
          { "field": "diabetes", "operator": "equals", "value": false }
        ],
        "results": [
          { "field": "decision", "value": "加費承保" },
          { "field": "premium_rate", "value": 1.2 },
          { "field": "remark", "value": "年輕但有高血壓，加費20%" }
